# Public Solana RPC endpoint. Use a reliable provider for production.
SOLANA_RPC_URL=

# Dedicated trading wallet secret. Configure only in the server/worker secret manager.
# Never commit a real value. Prefer a managed signer/KMS or isolated signing service.
TRADING_WALLET_PRIVATE_KEY=

# Safety defaults: live execution is deliberately locked.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# Risk controls
TAKE_PROFIT_PERCENT=20
STOP_LOSS_PERCENT=5
MAX_TRADE_SIZE_SOL=
MAX_DAILY_LOSS_SOL=
MAX_OPEN_POSITIONS=1
MAX_SLIPPAGE_BPS=100

# Worker
POLL_INTERVAL_MS=3000
