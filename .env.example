SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PUBLIC_ADDRESS=

# Optional Jupiter API key. Quote-only requests work keyless at a low rate limit.
JUPITER_API_KEY=

# Live execution remains locked.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# Server-side secret only; never put a wallet key in source control or chat.
# LIVE_WALLET_SECRET_KEY_JSON=

# USD trade notional, not SOL amount.
TRADE_SIZE_USD=1
TAKE_PROFIT_PERCENT=20
STOP_LOSS_PERCENT=5
MAX_TRADE_SIZE_SOL=
MAX_DAILY_LOSS_SOL=
MAX_OPEN_POSITIONS=1
MAX_SLIPPAGE_BPS=100
MAX_PRICE_IMPACT_BPS=100
MAX_ROUND_TRIP_COST_PERCENT=3

POLL_INTERVAL_MS=3000
