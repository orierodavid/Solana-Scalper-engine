{
  "name": "solana-scalper-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Wallet-based Solana scalping engine with guarded automated exits",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "worker": "node --experimental-strip-types src/worker.ts",
    "monitor:once": "node --experimental-strip-types src/monitor-once.ts",
    "discover:once": "node --experimental-strip-types src/discover-once.ts",
    "quote:once": "node --experimental-strip-types src/quote-once.ts",
    "scan:once": "node --experimental-strip-types src/scan-once.ts",
    "paper:worker": "node --experimental-strip-types src/paper-worker.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "zod": "^4.1.0",
    "dotenv": "^16.5.0",
    "@solana/spl-token": "^0.4.14"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "type": "module"
}
